# ResumeAI Environment Variables Configuration

# Copy this file to .env.local and fill in your actual values
# All variables are required for the application to work properly

# ========================================
# AI SERVICES
# ========================================

# Groq API (for AI-powered features like portfolio generation, cover letters)
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ========================================
# DATABASE & AUTHENTICATION
# ========================================

# Supabase Configuration (for user authentication, profile storage, and database)
# Get these values from: https://supabase.com/dashboard → Your Project → Settings → API

# Required for authentication and profile features to work
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ========================================
# GITHUB OAUTH (Optional - only if using GitHub login)
# ========================================

# Get these from: GitHub Settings → Developer settings → OAuth Apps → Your App
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ========================================
# APPLICATION CONFIGURATION
# ========================================

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth Secret (for secure session management)
# Generate a random string for production security
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=generate_random_string_here

# ========================================
# HOW TO USE THIS FILE
# ========================================

# Step 1: Copy this entire file
# Step 2: Rename it to .env.local 
# Step 3: Fill in your actual values from the services above
# Step 4: Save the .env.local file
# Step 5: Restart your development server: npm run dev

# ========================================
# IMPORTANT NOTES
# ========================================

# ALL VARIABLES ARE REQUIRED
# The application will NOT work properly without these environment variables

# SECURITY WARNING
# Never commit .env.local to Git or share it publicly
# This file is already in .gitignore for your protection

# GETTING HELP
# If you need help getting any of these values:
# 1. Check the documentation above for where to get them
# 2. Refer to the "WEBSITE_ARCHITECTURE.md" file for technical details
# 3. Each service has detailed setup instructions in their dashboards

# TROUBLESHOOTING
# If you add these variables and still have issues:
# 1. Check that you copied the values correctly (no extra spaces)
# 2. Ensure your .env.local file is in the project root directory
# 3. Restart your development server after making changes
# 4. Check browser console for authentication error messages